{
  "name": "synthetic-dual-compiler-memory",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "generate": "node generate.mjs",
    "bench": "node --expose-gc --max-old-space-size=16384 bench.mjs",
    "check": "node compare.mjs",
    "inspect": "node inspect.mjs",
    "profile": "node profiler/run.mjs",
    "profile:report": "node profiler/report.mjs",
    "profile:test": "node --test profiler/tests/*.test.mjs",
    "compare:versions": "node profiler/versions.mjs",
    "compare:report": "node profiler/versions-report.mjs",
    "history:import": "node profiler/history.mjs import",
    "history:render": "node profiler/history.mjs render",
    "history:reports": "node profiler/history-reports.mjs"
  },
  "dependencies": {
    "@rspack/core": "2.3.0-rc.0"
  }
}
